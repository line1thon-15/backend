# 실제 값은 .env에만 적는다 (커밋 금지, .gitignore가 이미 제외).
# 이 파일은 플레이스홀더만 담아 추적한다 — 새 환경 변수를 추가하면 여기도 같이 갱신한다.

# 예시 (프로젝트에 맞게 교체):
# DATABASE_URL=postgres://user:password@localhost:5432/dbname
# API_KEY=your-api-key-here

# ── backend (Architecture "시크릿과 환경 변수") ──
# local / test / production
APP_ENV=local
# 로컬 기본 8080, 운영은 PaaS가 주는 값
PORT=8080
# 시크릿. 비워 두면 OS 임시 디렉터리의 SQLite 파일(line1thon-backend-local.db)을 쓴다.
# 운영 예: postgresql+psycopg://<user>:<password>@<host>:5432/<dbname>
# DATABASE_URL=
# http / fake (테스트·로컬·E2E 기본 fake)
AI_CLIENT=fake
AI_SERVICE_URL=http://localhost:8081
# 시크릿 — AI 서비스와 같은 값
AI_SERVICE_TOKEN=<your-internal-token>
AI_SERVICE_TIMEOUT_SECONDS=<seconds>
# 운영 true
COOKIE_SECURE=false
LOG_LEVEL=INFO

# ── 시연 예시 데이터 적재 (T-67, `python -m app.demo.seed fixed`만 사용) ──
# 시크릿 — 고정 시연 계정의 보호자 비밀번호(8~128자)와 아이 PIN(숫자 4자리). 실제 비밀번호를 재사용하지 않는다.
# 적재 명령은 프로세스 환경 변수만 읽는다(이 형식의 설정 파일은 읽지 않음) — 실행하는 셸에서 export한 뒤 실행한다.
# DEMO_GUARDIAN_PASSWORD=<demo-guardian-password>
# DEMO_CHILD_PIN=<4-digit-pin>
